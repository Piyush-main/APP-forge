// AppForge Platform Schema
// This schema powers the AppForge platform itself.
// Each generated app gets its own dynamically-managed tables
// created by the runtime engine via raw SQL / migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform Auth ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  apps     App[]
  ApiKey   ApiKey[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Generated Apps ────────────────────────────────────────────────────────

model App {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String   @unique
  description String?
  icon        String   @default("🌐")
  config      Json     // the raw AppConfig JSON
  status      String   @default("draft") // draft | active | error
  schemaHash  String?  // detect config changes
  dbPrefix    String   @unique // e.g. "app_abc123_" — namespace for dynamic tables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploys   Deployment[]
  workflows WorkflowLog[]
  apiKeys   ApiKey[]

  @@map("apps")
}

model Deployment {
  id        String   @id @default(cuid())
  appId     String
  platform  String   // vercel | railway | render
  status    String   // pending | success | failed
  url       String?
  logs      String?
  createdAt DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

model WorkflowLog {
  id        String   @id @default(cuid())
  appId     String
  workflow  String
  trigger   String
  payload   Json?
  result    String   // success | failed | skipped
  message   String?
  createdAt DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("workflow_logs")
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  appId     String
  name      String
  keyHash   String    @unique
  prefix    String    // first 8 chars shown to user
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─── Platform Analytics ──────────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  appId     String
  event     String   // page_view | api_call | error | csv_import | workflow_run
  path      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([appId, event])
  @@map("analytics_events")
}
